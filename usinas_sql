-- ============================================================
-- 4. EXECUTAR CONSULTAS
-- ============================================================

-- 1 UPDATE / DELETE
UPDATE USINAS 
SET capacidade_mw = 350.00 
WHERE id_usina = 3;

DELETE FROM GERACAO 
WHERE id_geracao = 9;

-- 1 SELECT simples
SELECT nome_usina, tipo_fonte, capacidade_mw FROM USINAS;

-- 3 Funções Agregadas (SUM, AVG, COUNT)
SELECT 
    COUNT(id_geracao) AS total_registros,
    SUM(energia_gerada_mwh) AS energia_total_gerada,
    AVG(eficiencia_percentual) AS media_eficiencia
FROM GERACAO;

-- GROUP BY e HAVING
SELECT 
    tipo_fonte,
    AVG(capacidade_mw) AS media_capacidade
FROM USINAS
GROUP BY tipo_fonte
HAVING AVG(capacidade_mw) > 1000.00;

-- 1 JOIN entre tabelas
SELECT 
    u.nome_usina,
    u.tipo_fonte,
    r.nome_regiao
FROM USINAS u
INNER JOIN REGIOES r ON u.id_regiao = r.id_regiao;
