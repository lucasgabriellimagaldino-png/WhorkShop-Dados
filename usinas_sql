-- ============================================================
-- 1. CRIAR O SCHEMA
-- ============================================================
CREATE SCHEMA DESAFIO;
USE DESAFIO;

-- ============================================================
-- 2. CRIAR AS TABELAS
-- ============================================================

-- Tabela REGIOES (4 colunas + PK)
CREATE TABLE REGIOES (
    id_regiao INT PRIMARY KEY AUTO_INCREMENT,
    nome_regiao VARCHAR(50) NOT NULL,
    uf_principal CHAR(2) NOT NULL,
    populacao_estimada_milhoes DECIMAL(5, 2)
);

-- Tabela USINAS (4 colunas + PK + FK)
CREATE TABLE USINAS (
    id_usina INT PRIMARY KEY AUTO_INCREMENT,
    nome_usina VARCHAR(100) NOT NULL,
    tipo_fonte VARCHAR(50) NOT NULL, -- Ex: Hidrelétrica, Eólica, Solar
    capacidade_mw DECIMAL(10, 2) NOT NULL,
    id_regiao INT,
    FOREIGN KEY (id_regiao) REFERENCES REGIOES(id_regiao)
);

-- Tabela GERACAO (4 colunas + PK + FK)
CREATE TABLE GERACAO (
    id_geracao INT PRIMARY KEY AUTO_INCREMENT,
    data_registro DATE NOT NULL,
    energia_gerada_mwh DECIMAL(10, 2) NOT NULL,
    eficiencia_percentual DECIMAL(5, 2),
    id_usina INT,
    FOREIGN KEY (id_usina) REFERENCES USINAS(id_usina)
);

